{
  "name": "micro-box-s3",
  "target": "esp32s3",
  "flash_mb": 16,
  "psram_mb": 8,
  "display": {
    "width": 160,
    "height": 160,
    "pixel_clock_hz": 20000000,
    "panels": [
      {
        "host": "SPI3_HOST",
        "sclk": 42,
        "mosi": 2,
        "rst": 1,
        "dc": 41
      },
      {
        "host": "SPI2_HOST",
        "sclk": 38,
        "mosi": 39,
        "rst": 40,
        "dc": 0
      }
    ]
  },
  "audio": {
    "chip": "VB6824",
    "tx": 45,
    "rx": 48,
    "baud": 2000000
  },
  "touch_channels": [11],
  "buttons": {"a": 12, "b": 13, "active_level": 0},
  "motor": {
    "gpio": 14,
    "active_level": 1,
    "automatic_on_boot": false,
    "pwm_timer": 1,
    "pwm_channel": 1,
    "pwm_hz": 200,
    "max_pulse_ms": 400,
    "power": "external_driver_module_VBAT_conditional",
    "electrical_range_qualified": false
  },
  "controls_connector": {
    "name": "CN4",
    "pin_numbering": "schematic_not_physical_view",
    "pin_signals": ["TOUCH", "BUTTON_A", "BUTTON_B", "MOTOR_IN", "VBAT", "GND"]
  },
  "camera": {
    "sensor": "OV3660",
    "xclk": 16,
    "sda": 4,
    "scl": 5,
    "d0_d7": [
      21,
      9,
      3,
      10,
      47,
      18,
      17,
      15
    ],
    "vsync": 6,
    "href": 7,
    "pclk": 8
  }
}
